# Bind address. localhost keeps Strapi internal-only (AEGIS flow is
# Browser -> Django -> Strapi). Only set 0.0.0.0 in a production
# deployment that terminates traffic behind a reverse proxy / private
# network. On Render that is mandatory and must be a service env var:
# this file is gitignored and never deployed, so nothing here reaches the
# Render container.
HOST=localhost
PORT=1337

# Trusted browser origins for CORS, comma-separated, exact match only.
# Django reaches Strapi server-side (no CORS involved) and the admin
# panel is same-origin, so leave unset unless a browser client must call
# Strapi directly. Unset/empty in production = CORS fully closed.
# Example (non-secret): STRAPI_CORS_ORIGINS=http://localhost:8000
STRAPI_CORS_ORIGINS=
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aegis_cms_db
DATABASE_USERNAME=aegis_cms
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=false

# AEGIS Phase 7 integration (shared with Django backend)
# STRAPI_API_TOKEN is written automatically by bootstrap on first start.
# Render has an ephemeral runtime filesystem, so a token written here is
# lost on the next redeploy: on Render this value must be set as a service
# env var (same value in the Django service). Same rule for
# AEGIS_WEBHOOK_SECRET — see render.yaml.
STRAPI_API_TOKEN=
AEGIS_WEBHOOK_SECRET=tobemodified
AEGIS_WEBHOOK_URL=http://localhost:8000/webhooks/strapi/announcements/
