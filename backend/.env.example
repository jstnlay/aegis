DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local or Supabase)
DATABASE_NAME=aegis_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# For Supabase, set DATABASE_HOST to your project's DB host:
# DATABASE_HOST=db.your-project.supabase.co

# Persistent database connections. 60 seconds keeps a connection alive
# between requests instead of opening one per request.
DATABASE_CONN_MAX_AGE=60

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT lifetimes (minutes / days)
#
# An idle session lasts 15 minutes; "remember me" lasts a day. The access
# token is always 15 minutes.
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=1
JWT_SESSION_REFRESH_LIFETIME_MINUTES=15

# Shared cache for the rate limits (login, refresh, import, export, password
# change, registration).
#
# The DRF throttles run through the default cache. The local-memory cache is
# per-process, so with more than one worker every limit is multiplied by the
# number of workers. Point this at a Redis instance to share them.
#
# Locally, without a Redis service:
#     python scripts/fake_redis.py
#     REDIS_URL=redis://127.0.0.1:6379/0
#
# In production this must be a real Redis shared by every instance.
# REDIS_URL=redis://user:password@host:6379/0

# Where the frontend lives. Password reset, account invitation and
# set-password links are built from this.
AEGIS_FRONTEND_URL=http://127.0.0.1:5173

# The address outgoing mail is sent from.
DEFAULT_FROM_EMAIL=no-reply@aegis.local

# Phase 7 E2E seed password (used by backend/scripts/seed_phase7_e2e.py)
PHASE7_E2E_PASSWORD=your-e2e-seed-password

# Shared DEV/QA account password (used by
# python manage.py provision_qa_accounts, which the Render build runs after
# migrate). Set this ONLY in the Render service environment -- never commit a
# real value here. The command creates the five *.qa@aegis.local accounts on
# first run and never overwrites a password a tester has already changed.
QA_SHARED_PASSWORD=your-shared-qa-password
