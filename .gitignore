cms/.strapi/
# Runtime uploads stay out of git, but the folder itself must exist in a
# fresh checkout: @strapi/provider-upload-local checks it at boot
# (pathExistsSync) and throws "The upload folder (...) doesn't exist" on
# Render otherwise. Same intent as cms/.gitignore's `!public/uploads/.gitkeep`
# — a directory-scoped ignore here would make that negation ineffective.
cms/public/uploads/*
!cms/public/uploads/.gitkeep
cms/*.log

# Local OpenCode / Impeccable tooling
.opencode/

# Local Brave MCP browser profile
.browser-profile/

frontend/node_modules/
frontend/dist/
frontend/.env.*



# Trained risk model artifacts. Binary, environment-specific, and regenerated by
# `manage.py train_risk_model` -- never a reviewable source file, so committing
# one would only add a stale blob that disagrees with the code that reads it.
backend/aegis_backend/ai_engine/saved_models/

# QA test-case log for Testing Phase Cycle 1. Evidence of a manual test run
# against a deployed build, not a source file: the repository never re-executes
# it (no browser harness exists here), so a committed copy would read as the
# current state of the system while drifting further from it every commit.
docs/AEGIS Test Case Log Testing Phase Cycle 1 Complete.md


