# AEGIS frontend environment variables (copy to .env.local and adjust)
#
# Backend API base URL (Django REST Framework + SimpleJWT).
# The frozen API contract lives under /api/v1/ (docs/BACKEND_SPECIFICATION.md).
# The development backend runs on http://localhost:8000 and allows the
# Vite dev origin (http://localhost:5173) via CORS.
VITE_API_BASE_URL=http://localhost:8000/api/v1