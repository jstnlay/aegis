# AEGIS frontend environment variables (copy to .env.local and adjust)
#
# Backend API base URL (Django REST Framework + SimpleJWT).
# The frozen API contract lives under /api/v1/ (docs/BACKEND_SPECIFICATION.md).
# The development backend runs on http://localhost:8000 and allows the
# Vite dev origin (http://localhost:5173) via CORS.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# For a Vercel deployment that uses the API rewrite in vercel.json:
# VITE_API_BASE_URL=/api
# VITE_API_UPSTREAM_URL=https://aegis-0pav.onrender.com/api/v1

# Error reporting (Phase 7). Leave it unset and nothing is reported and no
# Sentry code is downloaded. Set it to the browser DSN of the Sentry project
# to report uncaught errors and render errors caught by ErrorBoundary. Set it
# on Vercel, not in this file: a DSN is a write-only publish key but it still
# does not belong in the repository.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
