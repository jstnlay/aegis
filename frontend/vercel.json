{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://aegis-0pav.onrender.com/api/v1/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://aegis-0pav.onrender.com/api/v1/:path*/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
